{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-ai-v2": "carousel",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["carousel-text-v1"]},
    "items": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "core_idea", "ad_copy", "content_extensions", "reference_sources", "frames", "execution"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "core_idea": {"type": "string", "minLength": 1},
          "core_subject": {"type": "string", "minLength": 1},
          "ad_copy": {"type": "string", "minLength": 1},
          "content_extensions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "reference_sources": {
            "type": "array", "minItems": 1,
            "items": {"type": "object", "additionalProperties": false, "required": ["name", "note"], "properties": {"name": {"type": "string", "minLength": 1}, "note": {"type": "string", "minLength": 1}}}
          },
          "frames": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["index", "description"],
              "properties": {
                "index": {"type": "integer", "minLength": 1},
                "description": {"type": "string", "minLength": 1}
              }
            }
          },
          "execution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["continuity_rules", "image_prompts"],
            "properties": {
              "continuity_rules": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "image_prompts": {
                "type": "array",
                "minItems": 2,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["index", "prompt"],
                  "properties": {
                    "index": {"type": "integer", "minLength": 1},
                    "prompt": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
